{
    "name": "mralaminahamed/ai-provider-for-minimax",
    "description": "AI Provider for MiniMax — an independent MiniMax integration for the WordPress AI Client.",
    "type": "wordpress-plugin",
    "version": "1.0.0",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Al Amin Ahamed",
            "email": "alamin.ahamed.dev@gmail.com",
            "homepage": "https://github.com/mralaminahamed"
        }
    ],
    "minimum-stability": "stable",
    "replace": {
        "wordpress/php-ai-client": "*"
    },
    "require": {
        "php": ">=7.4",
        "ext-json": "*"
    },
    "require-dev": {
        "wordpress/wp-ai-client": "^0.4",
        "brain/monkey": "^2.7",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "php-stubs/wordpress-stubs": "^6.9",
        "phpcompatibility/phpcompatibility-wp": "^2.1.8",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1.30",
        "phpunit/phpunit": "^9.6",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.3.0"
    },
    "autoload": {
        "psr-4": {
            "MiniMax\\MiniMaxAiProvider\\": "includes/"
        },
        "classmap": [
            "class-ai-provider-for-minimax.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "MiniMax\\MiniMaxAiProvider\\Tests\\": "tests/phpunit/"
        }
    },
    "scripts": {
        "stubs:install": "@composer install --working-dir=tools/ai-client --no-interaction",
        "test": [
            "@stubs:install",
            "phpunit"
        ],
        "test-f": "phpunit --filter",
        "lint": "vendor/bin/phpcs -p -s",
        "lint:fix": "vendor/bin/phpcbf -p",
        "lint:review": "phpcs ./includes ./alamin-ai-provider-for-minimax.php --standard=phpcs.plugin-review.xml",
        "lint:fix:review": "phpcbf ./includes ./alamin-ai-provider-for-minimax.php --standard=phpcs.plugin-review.xml",
        "analyze": [
            "@stubs:install",
            "phpstan analyse --memory-limit=2G --configuration=phpstan.neon.dist"
        ],
        "phpcs": "@lint",
        "phpcbf": "@lint:fix",
        "phpstan": "@analyze",
        "makepot": "wp i18n make-pot . languages/alamin-ai-provider-for-minimax.pot --package-name=\"AI Provider for MiniMax\" --exclude=node_modules,vendor,docs,release,tests,.wordpress-org,.playwright-mcp,.claude,.remember",
        "release": [
            "rm -rf release vendor",
            "@makepot",
            "mkdir -p release",
            "composer install --no-dev --optimize-autoloader",
            "rsync -av --exclude-from=.distignore . release/alamin-ai-provider-for-minimax/",
            "cd release && zip -r alamin-ai-provider-for-minimax.zip alamin-ai-provider-for-minimax/",
            "rm -rf release/alamin-ai-provider-for-minimax/",
            "composer install"
        ]
    },
    "config": {
        "platform": {
            "php": "7.4"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "php-http/discovery": true
        },
        "sort-packages": true
    }
}
