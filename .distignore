# Git
.git/
.gitattributes
.gitignore

# CI / tooling config — must never appear in the plugin zip
.distignore
.editorconfig
.github/
phpcs.xml.dist
phpstan.neon.dist
phpunit.xml.dist
phpunit.xml
phpcs.xml
phpstan.neon
*.dist

# Tests
tests/

# Dev-only tooling (php-ai-client side install for PHPStan/PHPUnit) — never ships
tools/

# Composer — development only.
#
# The plugin autoloads its own classes from includes/autoload.php and has no
# runtime dependency (composer.json requires php and ext-json, nothing more), so
# nothing under vendor/ belongs in the zip. The official WordPress AI provider
# plugins ship no vendor directory either.
vendor/
composer.json
composer.lock
composer.phar

# IDE
.idea/
.vscode/
*.sublime-*

# OS
.DS_Store
Thumbs.db

# Claude Code / AI tools
.claude/
.remember/
.playwright-mcp/
session-ses_*.md
CLAUDE.md
AGENTS.md

# WP.org assets (uploaded separately via SVN /assets/, not in plugin zip)
.wordpress-org/

# Build output
release/
build/
dist/
*.zip

# Documentation (not needed in plugin zip)
docs/

# Markdown (readme.txt is canonical for WP.org)
*.md
LICENSE
