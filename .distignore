# Git + dist tooling (hidden files not permitted in WP.org plugin zip)
.git/
.gitattributes
.gitignore
.distignore
.editorconfig

# Development config
.phpunit.result.cache
phpunit.xml
phpunit.xml.dist
phpcs.xml.dist
phpstan.neon.dist

# Tests
tests/

# Dependencies (rebuilt via composer install --no-dev in build)
/vendor/
composer.json
composer.lock
composer.phar

# IDE
.idea/
.vscode/
*.sublime-*

# OS
.DS_Store
Thumbs.db

# Claude Code / AI tools
.claude/
.remember/
.playwright-mcp/
session-ses_*.md
CLAUDE.md
AGENTS.md

# WP.org assets (uploaded separately via SVN /assets/, not in plugin zip)
.wordpress-org/

# Build output (created by `composer release`; must not recurse into the next zip)
release/
build/
*.zip

/docs/*

# Documentation (not needed in plugin zip)
docs/

# Markdown (readme.txt is canonical for WP.org)
*.md

# WordPress
wp-content/
wp-config.php
